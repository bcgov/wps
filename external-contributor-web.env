# copy this file to `web/apps/wps-web/.env` before starting the web app

VITE_API_BASE_URL=http://localhost:8080/api
VITE_HIDE_DISCLAIMER=true

# keycloak client configuration is public; no client secret is included here
VITE_KEYCLOAK_AUTH_URL=https://dev.loginproxy.gov.bc.ca/auth
VITE_KEYCLOAK_REALM=standard
VITE_KEYCLOAK_CLIENT=wps-web

# these optional integrations are disabled or use non-routable placeholders
VITE_MS_TEAMS_SPRINT_REVIEW_URL=http://localhost:3000
VITE_MIRO_SPRINT_REVIEW_BOARD_URL=http://localhost:3000
VITE_PMTILES_BUCKET=https://example.invalid
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_MUI_LICENSE_KEY=
VITE_BASEMAP_TILE_URL=https://example.invalid
VITE_BASEMAP_STYLE_URL=https://example.invalid
