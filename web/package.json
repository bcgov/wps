{
  "name": "wps-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "resolutions": {
    "react-is": "19.2.8"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev": "turbo dev",
    "playwright:ci": "turbo playwright:ci",
    "coverage:ci": "turbo coverage:ci",
    "finalizeCoverage": "yarn workspace @wps/wps-web run finalizeCoverage",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "^5.0.0",
    "turbo": "^2.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
