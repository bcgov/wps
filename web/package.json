{
  "name": "wps-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "resolutions": {
    "react-is": "19.2.8"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev": "turbo dev",
    "playwright:ci": "turbo playwright:ci",
    "coverage:ci": "turbo coverage:ci",
    "finalizeCoverage": "yarn workspace @wps/wps-web run finalizeCoverage",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@vitest/coverage-v8": "^4.1.0",
    "turbo": "^2.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
