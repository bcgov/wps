{
  "name": "wps-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1+sha512.107f80e13c40b41597284d03190c56f41a3d72b5c72c9ef799fc634d026ebfc5e89cd5964e97a2f014392637331c9354f4644e4f27303059fc88ebd12195d470",
  "resolutions": {
    "react-is": "19.2.8"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev": "turbo dev",
    "playwright:ci": "turbo playwright:ci",
    "coverage:ci": "turbo coverage:ci",
    "finalizeCoverage": "yarn workspace @wps/wps-web run finalizeCoverage",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@vitest/coverage-v8": "^5.0.0",
    "turbo": "^2.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
