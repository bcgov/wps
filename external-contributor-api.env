# copy this file to the repository root as `.env` before launching the `api`
# configuration in VS Code

ORIGINS="http://localhost http://localhost:3000 http://127.0.0.1 http://127.0.0.1:3000"
HOSTNAME=localhost

# these local database credentials are only for the contributor's local instance
POSTGRES_WRITE_HOST=localhost
POSTGRES_READ_HOST=localhost
POSTGRES_READ_USER=wpsread
POSTGRES_WRITE_USER=wps
POSTGRES_PASSWORD=wps
POSTGRES_DATABASE=wps
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USE=True
REDIS_PASSWORD=
REDIS_STATION_CACHE_EXPIRY=604800
REDIS_AUTH_CACHE_EXPIRY=604800
REDIS_DAILIES_BY_STATION_CODE_CACHE_EXPIRY=3600
REDIS_CACHE_ENV_CANADA=True
REDIS_CACHE_NOAA=True
REDIS_ENV_CANADA_CACHE_EXPIRY=21600
REDIS_NOAA_CACHE_EXPIRY=21600

NATS_STREAM_PREFIX=local
NATS_SERVER=localhost

AUTO_MAKE_FIXTURES=False
ASA_STATS_CACHE_ENABLED=False
PYTHONPYCACHEPREFIX=python_cache
DATA_RETENTION_THRESHOLD=358
GRIB_RETENTION_THRESHOLD=2
WFWX_MAX_PAGE_SIZE=1000
TPI_DEM_NAME=bc_dem_50m_tpi.tif
CLASSIFIED_TPI_DEM_NAME=bc_dem_50m_tpi_win100_classified.tif
CLASSPATH=packages/wps-api/libs/REDapp_Lib.jar:packages/wps-api/libs/WTime.jar:packages/wps-api/libs/hss-java.jar

# these values satisfy local configuration only; the related integrations will not work
WFWX_AUTH_URL=https://example.invalid
WFWX_BASE_URL=https://example.invalid
WFWX_USER=unconfigured
WFWX_SECRET=local-development-only
KEYCLOAK_PUBLIC_KEY=unconfigured
KEYCLOAK_CLIENT=wps-web
OPENSHIFT_BASE_URI=https://example.invalid
OPENSHIFT_CONSOLE_URL=https://example.invalid
STATUS_CHECKER_SECRET=local-development-only
CHATOPS_URL=https://example.invalid/webhook
CHATOPS_AUTH_TOKEN=local-development-only
SFMS_SECRET=local-development-only
SENTRY_DSN=
EARTHDATA_USERNAME=unconfigured
EARTHDATA_PASSWORD=local-development-only

# these fixed credentials only access the loopback-bound SeaweedFS development service
OBJECT_STORE_SERVER=http://127.0.0.1:9000
OBJECT_STORE_USER_ID=wps-local
OBJECT_STORE_SECRET=wps-local-password
OBJECT_STORE_BUCKET=wps-local
WX_OBJECT_STORE_USER_ID=wps-local
WX_OBJECT_STORE_SECRET=wps-local-password
WX_OBJECT_STORE_BUCKET=wps-wx-local
