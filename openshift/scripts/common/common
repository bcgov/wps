#!/bin/sh -l
#%
#% OpenShift Common Script
#%
#%   To be consumed by a set of OpenShift scripts with a pull request-based pipeline.
#%   See individual scripts for more information.
#%

# Specify halt conditions (errors, unsets, non-zero pipes), field separator and verbosity
#
set -euo pipefail
IFS=$'\n\t'
[ ! "${VERBOSE:-}" == "true" ] || set -x

# Receive parameters and source/load environment variables from a file
#
SUFFIX=${1:-}
APPLY=$([ "${2:-}" != "apply" ] || echo true)
RENDER=$([ "${2:-}" != "render" ] || echo true)
source "$(dirname ${0})/common/envars"

# If no parameters have been passed show the help header from this script
#
[ "${#}" -gt 0 ] || {
	THIS_FILE="$(dirname ${0})/$(basename ${0})"

	# Cat this file, grep #% lines and clean up with sed
	cat ${THIS_FILE} |
		grep "^#%" |
		sed -e "s|^#%||g" |
		sed -e "s|\${THIS_FILE}|${THIS_FILE}|g"
	exit
}

# Verify login once per run; scripts called from this one inherit OC_LOGIN_VERIFIED and
# skip the check. Render-only runs make no API calls, so they don't need a login. Fails
# (exit 1) rather than silently skipping the rest of the script.
#
if [ -z "${OC_LOGIN_VERIFIED:-}" ] && [ ! "${RENDER}" ]; then
	oc whoami >/dev/null || {
		echo -e "\nPlease verify oc login\n" >&2
		exit 1
	}
	export OC_LOGIN_VERIFIED=true
fi

# Render-only run type: print the manifest for a caller that batches all of its applies
# into one call (see oc_deploy_to_production.sh), then stop before applying anything.
#
# Renders JSON (oc process's default). Batches are concatenated JSON documents with no
# separators: a YAML `---` separator between JSON documents breaks oc's decoding.
#
# Renders YAML (`oc process -o yaml`) to match the cronjob scripts, so the batch is one YAML
# stream with `---` separators. A JSON document followed by `---` breaks oc's decoding.
#
render_and_exit_if_requested() {
	if [ "${RENDER}" ]; then
		eval "${1/ process / process -o yaml }"
		exit 0
	fi
}

# Wait for each deployment's rollout, failing if one fails or takes longer than 15 minutes
# (without a timeout, a rollout that is slow but still progressing never hits Kubernetes'
# progress deadline and is waited on indefinitely). Then fail unless every deployment's pod
# template carries this run's DEPLOY_VERSION, i.e. was actually applied by this run.
#
wait_for_rollouts_and_verify_deploy_version() {
	local deployment deployed stale
	for deployment in "$@"; do
		oc -n "${PROJ_TARGET}" rollout status "deployment/${deployment}" --timeout=15m
	done

	echo "Verifying deployments are from deploy version ${DEPLOY_VERSION}"
	deployed=$(oc -n "${PROJ_TARGET}" get deployment "$@" \
		-o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.template.metadata.annotations.wps/deploy-version}{"\n"}{end}')
	echo "${deployed}"
	stale=$(echo "${deployed}" | awk -v version="${DEPLOY_VERSION}" '$2 != version')
	if [ -n "${stale}" ]; then
		echo "ERROR: deployments not from deploy version ${DEPLOY_VERSION}:" >&2
		echo "${stale}" >&2
		exit 1
	fi
}

# Echo commands and dry run warnings
#
display_helper() {
	set +e
	if [ ! "${APPLY}" ]; then
		echo -e "\n*** This is a dry run.  Use 'apply' to deploy. ***"
	fi
	echo
	for i in $*; do
		echo -e "$i\n"
	done
	set -e
}
