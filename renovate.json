{
  "extends": [
    "github>bcgov/renovate-config#2026.9.26"
  ],
  "ignorePaths": [
    "openshift/s3-backup/docker/poetry.lock"
  ],
  "ignoreDeps": [
    "@psu/cffdrs_ts",
    "aiobotocore"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/",
        "/^\\.github/workflows/integration\\.yml$/"
      ],
      "matchStrings": [
        "corepack@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "corepack",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@sentry/react"
      ],
      "allowedVersions": "10.69.0"
    },
    {
      "matchPackageNames": [
        "node",
        "library/node",
        "docker.io/library/node",
        "@types/node",
        "corepack"
      ],
      "groupName": "Node.js",
      "groupSlug": "nodejs",
      "separateMajorMinor": false
    }
  ]
}
