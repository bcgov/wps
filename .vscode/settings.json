{
  // VSCode Settings
  "search.exclude": {
    "**/web/.turbo/cache": true
  },
  // Python
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["-v", "--tb=short", "--import-mode=importlib"],
  "python.analysis.include": ["backend", "sfms", "openshift"],
  "python.languageServer": "Pylance",
  // Off for now: "basic" reports ~1.7k existing type errors in the backend.
  // We should turn this on and ratchet it up ("basic" -> "standard") as we fix them.
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend/packages/wps-api/src",
    "${workspaceFolder}/backend/packages/wps-jobs/src",
    "${workspaceFolder}/backend/packages/wps-shared/src",
    "${workspaceFolder}/backend/packages/wps-sfms/src",
    "${workspaceFolder}/backend/packages/wps-wf1/src"
  ],
  // Use the ruff pinned in the selected interpreter's environment (uv.lock),
  // not the version bundled with the extension, so editor problems match CI.
  "ruff.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "autoDocstring.docstringFormat": "sphinx-notypes",
  "autoDocstring.startOnNewLine": true,
  // General Editor
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.exclude": {
    ".github": false,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/python_cache": true,
    "**/.venv": true
  },
  // JavaScript/TypeScript
  // The repo root has no node_modules, so point the Biome extension at the
  // binary installed in the web workspace (same pinned version repo-wide).
  "biome.lsp.bin": {
    "darwin-arm64": "./web/node_modules/@biomejs/cli-darwin-arm64/biome",
    "darwin-x64": "./web/node_modules/@biomejs/cli-darwin-x64/biome",
    "win32-arm64": "./web/node_modules/@biomejs/cli-win32-arm64/biome.exe",
    "win32-x64": "./web/node_modules/@biomejs/cli-win32-x64/biome.exe",
    "linux-arm64": "./web/node_modules/@biomejs/cli-linux-arm64/biome",
    "linux-x64": "./web/node_modules/@biomejs/cli-linux-x64/biome",
    "linux-arm64-musl": "./web/node_modules/@biomejs/cli-linux-arm64-musl/biome",
    "linux-x64-musl": "./web/node_modules/@biomejs/cli-linux-x64-musl/biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "typescript.preferences.importModuleSpecifier": "non-relative",
  // HTML
  "[html]": {
    "editor.formatOnSave": false
  },
  // YAML
  "files.associations": {
    "*.yml": "yaml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  // JSON
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // Spell checker
  "cSpell.words": [
    "actuals",
    "aiobotocore",
    "aiohttp",
    "Albers",
    "allclose",
    "anyio",
    "APCP",
    "astype",
    "asyncpg",
    "autoflush",
    "Behaviour",
    "botocore",
    "cffdrs",
    "colour",
    "cutline",
    "CWFIS",
    "determinates",
    "dtype",
    "excinfo",
    "fastapi",
    "FBAN",
    "ffmc",
    "fireweather",
    "firezone",
    "FWIs",
    "GDPS",
    "geoalchemy",
    "GEOGCS",
    "geopackage",
    "geospatial",
    "geotiff",
    "gpkg",
    "grib",
    "gribs",
    "Hasher",
    "hourlies",
    "HRDPS",
    "idir",
    "Indeterminates",
    "Kamloops",
    "luxon",
    "maxx",
    "maxy",
    "miny",
    "morecast",
    "nats",
    "ndarray",
    "Neighbour",
    "numba",
    "ORJSON",
    "osgeo",
    "PMTILES",
    "polygonize",
    "Polygonized",
    "polygonizing",
    "PRECIP",
    "PRIMEM",
    "PROJCS",
    "pydantic",
    "pyproj",
    "RDPS",
    "reduxjs",
    "reproject",
    "rocketchat",
    "rollup",
    "rtol",
    "sessionmaker",
