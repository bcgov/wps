meta {
  name: Get Hourly Actuals
  type: http
  seq: 5
}

get {
  url: {{API_BASE_URL}}/weather/v1/hourly?station_codes=322&start=2026-07-01&end=2026-07-02&sources=ACTUALS
  body: none
  auth: inherit
}

params:query {
  station_codes: 322
  start: 2026-07-01
  end: 2026-07-02
  sources: ACTUALS
}

docs {
  Hourly observations, with hourly ffmc, isi and fwi, and wind gust from the data mart.
}
