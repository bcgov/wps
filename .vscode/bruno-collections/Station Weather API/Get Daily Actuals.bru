meta {
  name: Get Daily Actuals
  type: http
  seq: 4
}

get {
  url: {{API_BASE_URL}}/weather/v1/daily?station_codes=322&start=2026-07-01&end=2026-07-31&sources=ACTUALS
  body: none
  auth: inherit
}

params:query {
  station_codes: 322
  start: 2026-07-01
  end: 2026-07-31
  sources: ACTUALS
}

docs {
  Daily observations at 20:00 UTC (noon PST): the 24 hour precip total, the FWI System
  indices (ffmc, dmc, dc, isi, bui, fwi), grass curing, danger rating and WF1 validity.
}
