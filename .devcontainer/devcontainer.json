{
	"name": "WPS Backend (API)",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.yml"
	],
	"service": "api",
	"workspaceFolder": "/workspaces/wps",
	"remoteUser": "worker",
	"updateRemoteUserUID": true,
	"shutdownAction": "stopCompose",
	"forwardPorts": [
		8080
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	"containerEnv": {
		"CLASSPATH": "/workspaces/wps/backend/packages/wps-api/libs/REDapp_Lib.jar:/workspaces/wps/backend/packages/wps-api/libs/WTime.jar:/workspaces/wps/backend/packages/wps-api/libs/hss-java.jar",
		"UV_PYTHON_DOWNLOADS": "never",
		"VIRTUAL_ENV": "/workspaces/wps/backend/.venv"
	},
	"postCreateCommand": "cd /workspaces/wps/backend && uv sync --all-extras --locked && uv pip install setuptools && uv pip install --no-build-isolation --no-cache-dir gdal==$(gdal-config --version)",
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/workspaces/wps/backend/.venv/bin/python",
				"terminal.integrated.defaultProfile.linux": "bash",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "/bin/bash"
					}
				}
			}
		}
	}
}
